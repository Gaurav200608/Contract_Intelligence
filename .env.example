# Authentication database; relative paths are resolved from the repository root.
AUTH_DATABASE_PATH=backend/auth_data/accounts.sqlite3

# Keep false only for local HTTP development. Set true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
APP_ENV=development

# Optional: check reachability of the primary official legal portal only.
# A reachable portal does not verify any legal provision. Leave disabled by default.
LEGAL_SOURCE_LIVE_CHECK=false

# Existing OCR options, when applicable:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\tools\poppler\Library\bin
